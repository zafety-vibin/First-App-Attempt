{
  "name": "wrldbldr-mcp-manager-backend",
  "version": "1.0.0",
  "description": "Wrldbldr MCP Manager backend API with Express and Keycloak authentication",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "mcp": "ts-node src/mcp/server.ts",
    "test": "vitest",
    "test:contract": "vitest run --dir tests/contract",
    "test:integration": "vitest run --dir tests/integration",
    "test:unit": "vitest run --dir tests/unit"
  },
  "keywords": [
    "express",
    "keycloak",
    "sqlite",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@types/multer": "^2.0.0",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "fast-levenshtein": "^3.0.0",
    "keycloak-connect": "^23.0.3",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.0",
    "multer": "^2.0.2",
    "openai": "^6.1.0",
    "pdf-parse": "^2.1.6",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
